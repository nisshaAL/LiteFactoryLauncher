<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LiteFactoryLauncher.Views.MainWindow"

        Title="LiteFactory Launcher"
        Width="1100"
        Height="650"
        MinWidth="900"
        MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="#101114">

    <Grid ColumnDefinitions="*,420">

        <!-- Левая часть -->
        <Grid Grid.Column="0"
              Margin="60">

            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="LITEFACTORY"
                           FontSize="46"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="LAUNCHER"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#777B85"
                           Margin="2,0,0,20"/>

                <TextBlock Text="Добро пожаловать."
                           FontSize="24"
                           Foreground="#E6E6E6"/>

                <TextBlock Text="Войди в аккаунт, чтобы продолжить."
                           FontSize="15"
                           Foreground="#858994"
                           Margin="0,8,0,0"/>

            </StackPanel>

            <TextBlock Text="LiteFactory Launcher • v0.0.1"
                       VerticalAlignment="Bottom"
                       Foreground="#555963"
                       FontSize="12"/>

        </Grid>


        <!-- Правая панель -->
        <Border Grid.Column="1"
                Background="#17191E">

            <StackPanel Width="300"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <TextBlock Text="Вход"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Войдите в свой аккаунт LiteFactory"
                           FontSize="13"
                           Foreground="#858994"
                           Margin="0,0,0,30"/>


                <!-- Логин -->

                <TextBlock Text="ЛОГИН"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#777B85"
                           Margin="2,0,0,7"/>

                <TextBox Name="UsernameBox"
                         Height="44"
                         FontSize="15"
                         Watermark="Введите логин"
                         Margin="0,0,0,18"/>


                <!-- Пароль -->

                <TextBlock Text="ПАРОЛЬ"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#777B85"
                           Margin="2,0,0,7"/>

                <TextBox Name="PasswordBox"
                         Height="44"
                         FontSize="15"
                         PasswordChar="●"
                         Watermark="Введите пароль"
                         Margin="0,0,0,24"/>


                <!-- Войти -->

                <Button Content="ВОЙТИ"
                        Height="46"
                        HorizontalContentAlignment="Center"
                        FontSize="14"
                        FontWeight="Bold"
                        Click="LoginButton_Click"/>

                <TextBlock Name="LoginError"
                            Text=""
                            HorizontalAlignment="Center"
                            Foreground="#FF5C5C"
                            FontSize="12"
                            Margin="0,12,0,0"/>

                <TextBlock Text="Нет аккаунта? Зарегистрируйтесь на сайте"
                           HorizontalAlignment="Center"
                           FontSize="11"
                           Foreground="#666A73"
                           Margin="0,22,0,0"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>